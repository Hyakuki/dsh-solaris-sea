{
  "name": "dsh-solaris-sea",
  "version": "0.2.0",
  "description": "索拉里斯之海：自己的记忆。把会话日志切成片段、写厚索引、存原话指针；能想起来、能取证、能特意记。",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "memory", "recall", "trace"],
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client.js",
    "./logs": "./src/logs.js",
    "./segment": "./src/segment.js",
    "./store": "./src/store.js"
  },
  "files": ["src", "bin", "client.js", "locale", "README.md", "cordis.patch.yml"],
  "engines": { "node": ">=22" },
  "scripts": {
    "scan": "node bin/scan.mjs",
    "doctor": "node bin/doctor.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["slots"],
      "external": ["react"]
    }
  },
  "peerDependencies": { "@deepseek-ai/dsh-tools": ">=0.1.0-rc.7" },
  "peerDependenciesMeta": { "@deepseek-ai/dsh-tools": { "optional": true } }
}
